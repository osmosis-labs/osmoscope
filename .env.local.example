# Local Development Database (Docker PostgreSQL)
DATABASE_URL="postgresql://osmometer:osmometer_dev@localhost:5432/osmometer"
POSTGRES_PRISMA_URL="postgresql://osmometer:osmometer_dev@localhost:5432/osmometer"

