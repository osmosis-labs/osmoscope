# Osmosis LCD API (Public endpoint, no key required)
NEXT_PUBLIC_LCD_BASE_URL=https://lcd.osmosis.zone

# Numia Data API
# Get your API key from: https://www.numia.xyz/
# Required for fetching historical staking APR data
NUMIA_API_KEY=your_numia_api_key_here

# Optional: Custom Numia API URL (defaults to public endpoint)
# NUMIA_API_URL=https://public-osmosis-api.numia.xyz

# Postgres database (Prisma Postgres in production; see DATABASE_SETUP.md).
# The site reads POSTGRES_PRISMA_URL (a Worker secret in production) and falls
# back to DATABASE_URL, which the crons (a GitHub Actions secret), scripts and
# the Prisma CLI (`db:migrate`, via prisma.config.ts) use. Both take the direct
# connection string.
POSTGRES_PRISMA_URL="postgres://..."
DATABASE_URL="postgres://..."

# Bearer token for calling the /api/cron/* routes over HTTP (manual triggers);
# they reject any request without `Authorization: Bearer <secret>`. Not needed
# for `yarn cron <name>` or the GitHub Actions workflow, which supply a per-run
# secret themselves. Generate a random value (e.g. `openssl rand -hex 32`).
CRON_SECRET=your_random_cron_secret_here

# Optional endpoint overrides (defaults shown). The archive node serves pruned
# history; the deep tx index backs governance vote history where our own
# node's index is too shallow; SQS is the price fallback for treasury holdings.
# ARCHIVE_LCD_BASE_URL=https://lcd.archive.osmosis.zone
# GOV_RECENT_LCD_BASE_URL=https://osmosis-api.polkachu.com
# SQS_API_URL=https://sqsprod.osmosis.zone

# Canonical public URL used by page metadata, robots.txt and the sitemap. Set
# it as a production build variable in Workers Builds; otherwise
# http://localhost:3000 is used.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain

# IBC rate-limit monitor alerts (/api/cron/rate-limits, see
# lib/rate-limits/README.md). A channel is active only when its variables are
# set. TELEGRAM_CHAT_ID is a comma-separated list; the first id also receives
# operational notices.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# Postgres connections per serverless instance (default 2; see lib/database.ts
# before raising it, the database plan's connection cap is the real limit).
# DB_POOL_MAX=2
