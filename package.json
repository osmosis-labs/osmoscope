{
  "name": "osmometer",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard for displaying the main tokenomics of the OSMO token",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "cron": "tsx scripts/run-cron.ts",
    "populate-from-archive": "tsx scripts/populate-from-archive.ts",
    "normalize-supply-offset": "tsx scripts/normalize-supply-offset.ts",
    "backfill-genesis-2021": "tsx scripts/backfill-genesis-2021.ts",
    "recompute-inflation": "tsx scripts/recompute-inflation.ts",
    "populate-staking-apr": "tsx scripts/populate-staking-apr-history.ts",
    "resync-staking-apr": "tsx scripts/resync-staking-apr.ts",
    "populate-revenue": "tsx scripts/populate-revenue-history.ts",
    "validate-history": "tsx scripts/validate-history.ts",
    "migrate-json-to-db": "tsx scripts/migrate-json-to-db.ts",
    "populate-treasury": "tsx scripts/populate-treasury.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.105.0",
    "bech32": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "lru-cache": "^11.5.3",
    "modern-screenshot": "^4.7.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.156.0"
  },
  "resolutions": {
    "react-is": "^19.3.1",
    "glob@npm:10.3.3": "^10.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
