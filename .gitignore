# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (the two example files stay tracked)
.env
.env.*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# historical data
/data

/lib/generated/prisma
.claude/settings.local.json

# scratch dumps at the repo root (probe output, one-off scripts); the tracked
# config files are listed explicitly so nothing else at the root is picked up
/*.json
!/package.json
!/tsconfig.json
!/.eslintrc.json
!/.prettierrc.json
/*.mjs
!/postcss.config.mjs

# Cloudflare (OpenNext build output, wrangler local state)
.open-next/
.wrangler/
